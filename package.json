{
  "name": "@eatsjobs/cookie-store-polyfill",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "Cookie Store Polyfill for browsers that don't support it - provides async cookie management via the CookieStore API",
  "license": "MIT",
  "keywords": [
    "cookie",
    "cookiestore",
    "polyfill",
    "browser",
    "web-api"
  ],
  "browser": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "jsdom": "^27.3.0",
    "tsdown": "~0.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
